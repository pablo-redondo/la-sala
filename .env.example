# TMDB (The Movie Database) — fuente principal de datos: catálogo, tendencias,
# fichas de película/serie, reparto, proveedores de streaming, etc.
# Consigue una clave gratuita en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Opcional — solo si necesitas apuntar a un proxy/mirror de la API de TMDB.
# Por defecto usa https://api.themoviedb.org/3
TMDB_BASE_URL=

# OMDb — usado por las rutas heredadas /movie/[id] y /tv/[id] (búsqueda por
# IMDb ID). Clave gratuita en https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
